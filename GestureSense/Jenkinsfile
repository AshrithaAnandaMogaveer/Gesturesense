
// ══════════════════════════════════════════════════════════════════════════════
// GestureSense – Jenkins CI/CD Pipeline
// Stages: Checkout → Install → Lint → Test → Build Docker → Push → Deploy
// ══════════════════════════════════════════════════════════════════════════════

pipeline {
    agent any

    environment {
        APP_NAME    = 'gesturesense'
        IMAGE_NAME  = "gesturesense/app"
        IMAGE_TAG   = "${env.BUILD_NUMBER}"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
    }

    stages {

        // ── Stage 1: Checkout ──────────────────────────────────────────────
        stage('Checkout') {
            steps {
                echo '📥 Checking out source code...'
                checkout scm
            }
        }

        // ── Stage 2: Setup Python environment ─────────────────────────────
        stage('Setup Environment') {
            steps {
                echo '🐍 Setting up Python virtual environment...'

                bat '''
                    py -m venv venv

                    call venv\\Scripts\\activate

                    py -m pip install --upgrade pip

                    pip install -r requirements.txt
                '''
            }
        }

        // ── Stage 3: Lint ──────────────────────────────────────────────────
        stage('Lint') {
            steps {
                echo '🔍 Running code quality checks...'

                bat '''
                    call venv\\Scripts\\activate

                    pip install flake8

                    flake8 . --max-line-length=120 --exclude=venv,__pycache__,.git
                '''
            }
        }

        // ── Stage 4: Tests ─────────────────────────────────────────────────
        stage('Test') {
            steps {
                echo '🧪 Running test suite...'

                bat '''
                    call venv\\Scripts\\activate

                    pip install pytest

                    pytest tests/ -v --tb=short
                '''
            }

            post {
                always {
                    junit allowEmptyResults: true, testResults: 'test-results/*.xml'
                }
            }
        }

        // ── Stage 5: Build Docker image ────────────────────────────────────
        stage('Build Docker Image') {
            steps {
                echo "🐳 Building Docker image: ${IMAGE_NAME}:${IMAGE_TAG}"

                bat """
                    docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -t ${IMAGE_NAME}:latest .
                """
            }
        }

        // ── Stage 6: Security scan ─────────────────────────────────────────
        stage('Security Scan') {
            steps {
                echo '🔒 Running security scan...'

                bat '''
                    call venv\\Scripts\\activate

                    pip install safety

                    safety check -r requirements.txt
                '''
            }
        }

        // ── Stage 7: Push to registry ──────────────────────────────────────
        stage('Push Image') {
            when {
                branch 'main'
            }

            steps {
                echo '📤 Pushing image to Docker registry...'

                echo '⚠ Docker registry push skipped (credentials not configured yet).'
            }
        }

        // ── Stage 8: Deploy ────────────────────────────────────────────────
        stage('Deploy') {
            when {
                branch 'main'
            }

            steps {
                echo '🚀 Deploying GestureSense...'

                bat """
                    docker stop gesturesense-app || exit /b 0

                    docker rm gesturesense-app || exit /b 0

                    docker run -d ^
                        --name gesturesense-app ^
                        --restart unless-stopped ^
                        -p 5000:5000 ^
                        ${IMAGE_NAME}:latest
                """
            }
        }
    }

    post {

        success {
            echo '✅ Pipeline completed successfully!'
        }

        failure {
            echo '❌ Pipeline failed. Check logs above.'
        }

        always {

            bat '''
                docker system prune -f
            '''

            cleanWs()
        }
    }
}
